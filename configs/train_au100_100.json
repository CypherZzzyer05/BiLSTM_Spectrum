{
  "dataset": "../examples/au100_metal8_100/dataset.npz",
  "output_dir": "../runs/au100_bilstm_100",
  "allow_validation_data": true,
  "seed": 42,
  "device": "auto",
  "epochs": 100,
  "batch_size": 8,
  "learning_rate": 0.0003,
  "weight_decay": 0.001,
  "gradient_clip_norm": 1.0,
  "early_stopping_patience": 20,
  "min_delta": 1e-05,
  "lr_patience": 8,
  "lr_factor": 0.5,
  "min_learning_rate": 1e-06,
  "mixed_precision": true,
  "model": {
    "spectrum_points": 1000,
    "patch_count": 100,
    "embedding_dim": 128,
    "hidden_size": 64,
    "recurrent_layers": 2,
    "mlp_dim": 256,
    "dropout": 0.1,
    "geometry_dim": 7,
    "angle_symmetry": "square_periodic",
    "position_encoding": true
  }
}
